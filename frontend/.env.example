# Copiá este archivo como .env.local (no se sube a GitHub) para cambiar la configuración.

# true (o sin definir): usa los datos de prueba de src/services/mocks
# false: usa el backend real
VITE_USAR_MOCKS=true

# Dirección del backend (solo se usa con VITE_USAR_MOCKS=false)
VITE_API_URL=http://localhost:8080
